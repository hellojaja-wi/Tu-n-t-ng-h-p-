-- ==================== VÒNG LẶP RENDER CHÍNH ====================
RunService.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end

	if hasDrawing and fovCircle then
		local vp = cam.ViewportSize
		fovCircle.Position = Vector2.new(vp.X / 2, vp.Y / 2)
		fovCircle.Radius = fovRadius
		fovCircle.Color = rainbowColor
		fovCircle.Visible = (aimbotEnabled and fovEnabled)
	end

	if aimbotEnabled then
		local targetPart = getClosestTargetInFOV()
		if targetPart then
			local targetCFrame = CFrame.new(cam.CFrame.Position, targetPart.Position)
			cam.CFrame = cam.CFrame:Lerp(targetCFrame, math.clamp(aimSmoothness, 0.05, 1))
		end
	end

	if espEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local teammate = isTeammate(plr)
				if enemyOnly and teammate then
					local oldHl = plr.Character:FindFirstChild("TuanRainbowESP")
					if oldHl then
						oldHl:Destroy()
					end
				else
					local hl = plr.Character:FindFirstChild("TuanRainbowESP")
					if not hl then
						hl = Instance.new("Highlight")
						hl.Name = "TuanRainbowESP"
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.FillTransparency = 0.5
						hl.OutlineTransparency = 0
						hl.Parent = plr.Character
					end
					hl.Adornee = plr.Character
					local col = teammate and friendColor or rainbowColor
					hl.FillColor = col
					hl.OutlineColor = col
				end
			end
		end
	end
end)

